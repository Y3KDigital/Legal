# Database
DATABASE_URL="postgresql://user:password@localhost:5432/mcp_law"

# Redis
REDIS_URL="redis://localhost:6379"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-random-secret-min-32-chars"

